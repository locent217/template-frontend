# Public frontend configuration only. Never store secrets in VITE_ variables.
VITE_APP_NAME="Example Company Workspace"
VITE_APP_SHORT_NAME="Workspace"
VITE_APP_TITLE="Example Company Workspace"
VITE_APP_DESCRIPTION="Internal management workspace"
VITE_COMPANY_NAME="Example Company"
VITE_API_URL="https://api.example.com"
VITE_ENABLE_REGISTRATION=false
VITE_ENABLE_DEBUG=false

# Place an image in public/company-logo.png, or set another public URL
VITE_APP_LOGO_URL=/company-logo.png

# Optional real-time notifications (npm install laravel-echo pusher-js)
VITE_REVERB_ENABLED=false
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
