# Public frontend configuration only. Never store secrets in VITE_ variables.
VITE_APP_NAME="Company Management System"
VITE_APP_SHORT_NAME="Workspace"
VITE_APP_TITLE="Company Management System"
VITE_APP_DESCRIPTION="Internal management workspace"
VITE_COMPANY_NAME="My Company"
VITE_API_URL="https://api.example.com"
VITE_ENABLE_REGISTRATION=false
VITE_ENABLE_DEBUG=false

# Place an image in public/company-logo.png, or set another public URL
VITE_APP_LOGO_URL=/company-logo.png

VITE_REVERB_ENABLED=true
VITE_REVERB_APP_KEY=your-reverb-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http